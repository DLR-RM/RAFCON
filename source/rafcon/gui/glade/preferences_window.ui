<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="preferences_window">
    <property name="title" translatable="1">Preferences</property>
    <property name="default_width">1000</property>
    <property name="default_height">600</property>
    <property name="child">
      <object class="GtkBox" id="vbox1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkNotebook" id="notebook1">
            <property name="vexpand">1</property>
            <property name="focusable">1</property>
            <property name="tab_pos">left</property>
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolledwindow1">
                    <property name="focusable">1</property>
                    <property name="child">
                      <object class="GtkViewport" id="viewport1">
                        <property name="child">
                          <object class="GtkBox" id="alignment1">
                            <property name="can_focus">0</property>
                            <child>
                              <object class="GtkTreeView" id="config_tree_view">
                                <property name="focusable">1</property>
                                <property name="enable_grid_lines">vertical</property>
                                <child internal-child="selection">
                                  <object class="GtkTreeSelection" />
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="config_col">
                                    <property name="spacing">1</property>
                                    <property name="sizing">autosize</property>
                                    <property name="title">Configuration</property>
                                    <property name="expand">1</property>
                                    <child>
                                      <object class="GtkCellRendererText" id="core_config_key_renderer" />
                                      <attributes>
                                        <attribute name="text">0</attribute>
                                      </attributes>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="value_col">
                                    <property name="sizing">autosize</property>
                                    <property name="title">Value</property>
                                    <property name="expand">1</property>
                                    <child>
                                      <object class="GtkCellRendererToggle" id="core_config_toggle_renderer" />
                                      <attributes>
                                        <attribute name="visible">4</attribute>
                                        <attribute name="activatable">3</attribute>
                                        <attribute name="active">6</attribute>
                                      </attributes>
                                    </child>
                                    <child>
                                      <object class="GtkCellRendererText" id="core_config_value_renderer" />
                                      <attributes>
                                        <attribute name="visible">2</attribute>
                                        <attribute name="editable">5</attribute>
                                        <attribute name="text">1</attribute>
                                      </attributes>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="general_config">
                    <property name="width_request">0</property>
                    <property name="label" translatable="1">Core Config</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">1</property>
                <property name="child">
                  <object class="GtkViewport" id="viewport4">
                    <property name="child">
                      <object class="GtkBox" id="alignment4">
                        <property name="can_focus">0</property>
                        <child>
                          <object class="GtkBox" id="hbox2">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkScrolledWindow" id="scrolledwindow4">
                                <property name="vexpand">1</property>
                                <property name="focusable">1</property>
                                <property name="child">
                                  <object class="GtkTreeView" id="library_tree_view">
                                    <property name="focusable">1</property>
                                    <property name="headers_clickable">0</property>
                                    <property name="enable_grid_lines">vertical</property>
                                    <child internal-child="selection">
                                      <object class="GtkTreeSelection" />
                                    </child>
                                    <child>
                                      <object class="GtkTreeViewColumn" id="lib_col">
                                        <property name="spacing">1</property>
                                        <property name="sizing">autosize</property>
                                        <property name="title">Library</property>
                                        <property name="expand">1</property>
                                        <child>
                                          <object class="GtkCellRendererText" id="library_config_key_renderer" />
                                          <attributes>
                                            <attribute name="text">0</attribute>
                                          </attributes>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkTreeViewColumn" id="lib_path_col">
                                        <property name="sizing">autosize</property>
                                        <property name="title">Path</property>
                                        <property name="expand">1</property>
                                        <child>
                                          <object class="GtkCellRendererText" id="library_config_value_renderer" />
                                          <attributes>
                                            <attribute name="text">1</attribute>
                                          </attributes>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="hbox3">
                                <property name="width_request">0</property>
                                <child>
                                  <object class="GtkButton" id="remove_library_button">
                                    <property name="label">gtk-remove</property>
                                    <property name="width_request">90</property>
                                    <property name="focusable">1</property>
                                    <property name="receives_default">1</property>
                                    </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="add_library_button">
                                    <property name="label">gtk-add</property>
                                    <property name="width_request">90</property>
                                    <property name="focusable">1</property>
                                    <property name="receives_default">1</property>
                                    </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="libraries">
                    <property name="label" translatable="1">Libraries</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">2</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolledwindow2">
                    <property name="focusable">1</property>
                    <property name="child">
                      <object class="GtkViewport" id="viewport2">
                        <property name="child">
                          <object class="GtkBox" id="alignment2">
                            <property name="can_focus">0</property>
                            <child>
                              <object class="GtkTreeView" id="gui_tree_view">
                                <property name="focusable">1</property>
                                <property name="headers_clickable">0</property>
                                <child internal-child="selection">
                                  <object class="GtkTreeSelection" />
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="config_col1">
                                    <property name="spacing">1</property>
                                    <property name="sizing">autosize</property>
                                    <property name="title">Configuration</property>
                                    <property name="expand">1</property>
                                    <child>
                                      <object class="GtkCellRendererText" id="gui_config_key_renderer" />
                                      <attributes>
                                        <attribute name="text">0</attribute>
                                      </attributes>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="value_col1">
                                    <property name="sizing">autosize</property>
                                    <property name="title">Value</property>
                                    <property name="expand">1</property>
                                    <child>
                                      <object class="GtkCellRendererToggle" id="gui_config_toggle_renderer" />
                                      <attributes>
                                        <attribute name="visible">4</attribute>
                                        <attribute name="activatable">3</attribute>
                                        <attribute name="active">6</attribute>
                                      </attributes>
                                    </child>
                                    <child>
                                      <object class="GtkCellRendererText" id="gui_config_value_renderer" />
                                      <attributes>
                                        <attribute name="visible">2</attribute>
                                        <attribute name="editable">5</attribute>
                                        <attribute name="text">1</attribute>
                                      </attributes>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="gui_config">
                    <property name="width_request">180</property>
                    <property name="label" translatable="1">GUI Config</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="position">3</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolledwindow3">
                    <property name="focusable">1</property>
                    <property name="child">
                      <object class="GtkViewport" id="viewport3">
                        <property name="child">
                          <object class="GtkBox" id="alignment3">
                            <property name="can_focus">0</property>
                            <child>
                              <object class="GtkTreeView" id="shortcut_tree_view">
                                <property name="focusable">1</property>
                                <property name="headers_clickable">0</property>
                                <property name="enable_grid_lines">vertical</property>
                                <child internal-child="selection">
                                  <object class="GtkTreeSelection" />
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="action_col">
                                    <property name="spacing">1</property>
                                    <property name="sizing">autosize</property>
                                    <property name="title">Action</property>
                                    <property name="expand">1</property>
                                    <child>
                                      <object class="GtkCellRendererText" id="shortcut_config_key_renderer" />
                                      <attributes>
                                        <attribute name="text">0</attribute>
                                      </attributes>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="shortcut">
                                    <property name="sizing">autosize</property>
                                    <property name="title">Shortcut</property>
                                    <property name="expand">1</property>
                                    <child>
                                      <object class="GtkCellRendererText" id="shortcut_config_value_renderer" />
                                      <attributes>
                                        <attribute name="text">1</attribute>
                                      </attributes>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel" id="shortcuts">
                    <property name="width_request">180</property>
                    <property name="label" translatable="1">Shortcuts</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox1">
            <property name="valign">center</property>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="halign">center</property>
                <property name="label" translatable="1">Cancel</property>
                <property name="width_request">90</property>
                <property name="focusable">1</property>
                <property name="receives_default">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="apply_button">
                <property name="halign">center</property>
                <property name="label" translatable="1">Apply</property>
                <property name="width_request">90</property>
                <property name="focusable">1</property>
                <property name="receives_default">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="export_button">
                <property name="halign">center</property>
                <property name="label" translatable="1">Export</property>
                <property name="width_request">90</property>
                <property name="focusable">1</property>
                <property name="receives_default">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ok_button">
                <property name="halign">center</property>
                <property name="label" translatable="1">Ok</property>
                <property name="width_request">90</property>
                <property name="focusable">1</property>
                <property name="receives_default">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="import_button">
                <property name="halign">center</property>
                <property name="label" translatable="1">Import</property>
                <property name="width_request">90</property>
                <property name="focusable">1</property>
                <property name="receives_default">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox2">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="core_label">
                <property name="vexpand">1</property>
                <property name="label" translatable="1">Core Config Path: </property>
                <property name="halign">start</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="gui_label">
                <property name="vexpand">1</property>
                <property name="label" translatable="1">GUI Config Path: </property>
                <property name="single_line_mode">1</property>
                <property name="halign">start</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>