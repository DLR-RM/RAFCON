<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="linkage_container">
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="hexpand">1</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="data_linkage_label_eventbox">
            <property name="can_focus">0</property>
            <child>
              <object class="GtkLabel" id="data_linkage_label">
                <property name="label" translatable="1">DATA LINKAGE</property>
                <property name="halign">start</property>
              </object>
            </child>
            <style>
              <class name="widget-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox2">
            <property name="vexpand">1</property>
            <property name="homogeneous">1</property>
            <child>
              <object class="GtkBox" id="input_box">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel" id="input_label">
                    <property name="label" translatable="1">Input</property>
                    <property name="halign">start</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="inputs_scroller">
                    <property name="vexpand">1</property>
                    <property name="focusable">1</property>
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="output_box">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel" id="output_label">
                    <property name="label" translatable="1">Output</property>
                    <property name="halign">start</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="outputs_scroller">
                    <property name="vexpand">1</property>
                    <property name="focusable">1</property>
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="scoped_box">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel" id="scoped_label">
                    <property name="label" translatable="1">Scope</property>
                    <property name="halign">start</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scoped_scroller">
                    <property name="vexpand">1</property>
                    <property name="focusable">1</property>
                    <child>
                      <placeholder/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="vbox2">
        <property name="hexpand">1</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="logical_linkage_label_eventbox">
            <property name="can_focus">0</property>
            <child>
              <object class="GtkLabel" id="logical_linkage_label">
                <property name="label" translatable="1">LOGICAL LINKAGE</property>
                <property name="halign">start</property>
              </object>
            </child>
            <style>
              <class name="widget-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="outcomes_box">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="outcomes_label">
                <property name="label" translatable="1">Outcomes</property>
                <property name="halign">start</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="outcomes_scroller">
                <property name="vexpand">1</property>
                <property name="focusable">1</property>
                <child>
                  <placeholder/>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
